# mstpdynasty.com environment. Copy to .env.local for local dev. Never commit real values.
# Everything is optional: with nothing set, the site renders from live Sleeper data,
# models run, and roast / email features show a "not configured yet" state.

# League. Defaults to MSTP Dynasty (1406497799725424640). For local work on a completed
# season use the RT fixture league (`npm run dev:rt`, id in fixtures/manifest.json).
# Any other league is a dev league: nothing is ever emailed or published about it.
LEAGUE_ID=

# Dev only: pretend the league is in season at this week (UI work on old data).
LEAGUE_WEEK_OVERRIDE=

# Dev only: "fixtures" replays fixtures/ (from `npm run fixtures`) instead of the network.
DATA_SOURCE=
FIXTURES_DIR=

# Roast engine (writes The Roast newsletter and item roasts).
ANTHROPIC_API_KEY=
# Roast lore: JSON object of manager first name -> running jokes, e.g.
# ROAST_NOTES={"Ethan":"...","Peter":"..."}
# Lore never goes in the repo (it is public). The store key "roast-notes" is the other source; env wins.
ROAST_NOTES=

# Email (Resend).
RESEND_API_KEY=
EMAIL_FROM="The Roast <roast@mstpdynasty.com>"
COMMISSIONER_EMAIL=
# review (default): drafts go to COMMISSIONER_EMAIL with an approve link. auto: send to all subscribers.
NEWSLETTER_MODE=review

# Site password gate. If set, every page requires it (/enter).
SITE_PASSWORD=

# Secrets for /api/cron/daily (Authorization: Bearer) and HMAC-signed approve / unsubscribe links.
CRON_SECRET=
ADMIN_SECRET=

# Public base URL used in emails, e.g. https://mstpdynasty.com
SITE_URL=

# KV store (Upstash Redis). Either pair works. Without them, a JSON file store in .data/ is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides: upstash | file | memory, key prefix, file store directory.
STORE_BACKEND=
STORE_PREFIX=
DATA_DIR=

# Loser of the Week images (phase 2): none | openai | gemini
IMAGE_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
