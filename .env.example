# mstpdynasty.com environment. Copy to .env.local for local dev. Never commit real values.
# Everything is optional: with nothing set, the site renders from live Sleeper data,
# models run, and writer / email features show a "not configured yet" state.

# League. Defaults to MSTP Dynasty (1406497799725424640). For local work on a completed
# season use the dev fixture league (`npm run dev:rt`, id in fixtures/manifest.json).
# Any other league is a dev league: nothing is ever emailed or published about it.
LEAGUE_ID=

# Dev only: pretend the league is in season at this week (UI work on old data).
LEAGUE_WEEK_OVERRIDE=

# Dev only: "fixtures" replays fixtures/ (from `npm run fixtures`) instead of the network.
DATA_SOURCE=
FIXTURES_DIR=
# `npm run fixtures` only: the Sleeper user whose 2025 leagues hold the dev fixture league, and that
# league's name. Or put {"userId":"...","leagueName":"..."} in fixtures/config.json (gitignored).
FIXTURE_USER_ID=
FIXTURE_LEAGUE_NAME=

# The writer (newsletter prose, instant takes on trades and picks, one-liners on stat tables).
# Without it everything publishes facts only and one-liners are simply absent.
ANTHROPIC_API_KEY=
# Roast lore: JSON object of manager first name -> running jokes, e.g.
# ROAST_NOTES={"Ethan":"...","Peter":"..."}
# Lore never goes in the repo (it is public). The store key "roast-notes" is the other source; env wins.
ROAST_NOTES=

# Email (Resend). Sender defaults to "MSTP Dynasty" at the league's own address (lib/env.ts).
RESEND_API_KEY=
EMAIL_FROM=
# Who gets the newsletter: comma-separated addresses. Set it ONLY as a Vercel Secret or in
# .env.local: never in the repo, a test, a doc or a log. Unsubscribes are stored as opt-outs.
LEAGUE_EMAILS=
# Gets review copies (with the approve link) and every POST /api/admin/test-email (nobody else
# ever gets a test). Env only, like LEAGUE_EMAILS.
COMMISSIONER_EMAIL=
# review (default): each issue goes to COMMISSIONER_EMAIL first with an approve link, then to
# LEAGUE_EMAILS once approved. auto: straight to LEAGUE_EMAILS.
NEWSLETTER_MODE=review

# Site password gate. If set, every page requires it (/enter). Use a long passphrase: guesses are
# rate limited (10 per IP, 100 overall, per 15 minutes) but everyone shares it.
SITE_PASSWORD=
# Optional: change this to sign everyone out of the gate without changing the password.
GATE_VERSION=

# CRON_SECRET: bearer for /api/cron/daily. ADMIN_SECRET: HMAC key for the approve / unsubscribe
# links, and the bearer for POST /api/admin/test-email:
#   curl -X POST -H "Authorization: Bearer $ADMIN_SECRET" https://mstpdynasty.com/api/admin/test-email
# Make it long and random: `openssl rand -base64 32`. The admin bearer is refused (401) while
# ADMIN_SECRET is shorter than 32 characters, and bearer attempts are limited (10 per IP, 30 overall,
# per 15 minutes, counted before the compare). With either bearer, /api/health also shows the
# recipient counts.
# Without CRON_SECRET the cron route runs under `next dev` (curl localhost:3000/api/cron/daily) only
# while RESEND_API_KEY and ANTHROPIC_API_KEY are unset (next dev listens on the whole network), and is
# refused (503) under `next start` and on Vercel. Vercel's cron fires once a day at 12:00 UTC (vercel.json).
# With SITE_PASSWORD set, /api/tick also takes the CRON_SECRET bearer (or the gate cookie).
CRON_SECRET=
ADMIN_SECRET=
# OPTOUT_SECRET: optional, set once and never rotate. It keys the unsubscribe links and the stored
# opt-outs, so ADMIN_SECRET can be rotated (after a leak) without putting back everyone who
# unsubscribed. Without it ADMIN_SECRET keys them, and rotating ADMIN_SECRET resets every opt-out
# and breaks every unsubscribe link already sent. `openssl rand -base64 32`.
OPTOUT_SECRET=

# Public base URL used in emails, e.g. https://mstpdynasty.com. Set it before sending any email:
# approve and unsubscribe links are built from it (fallback: VERCEL_URL, then localhost).
SITE_URL=

# KV store (Upstash Redis). Either pair works. Without them, a JSON file store in .data/ is used.
# On Vercel that file store is per instance (/tmp), so there the writer stays off and league sends
# refuse until KV is connected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides: upstash | file | memory, key prefix, file store directory.
STORE_BACKEND=
STORE_PREFIX=
DATA_DIR=

# Loser of the Week images (phase 2): none | openai | gemini
IMAGE_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
